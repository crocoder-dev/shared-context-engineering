import "../generation-contract-check.pkl" as contract

local artifacts = new Mapping {
  for (path, text in contract.generatedArtifacts) {
    [path] = if (path == "config/.opencode/skills/sce-decision/SKILL.md")
      text + "\n## Decision gate"
    else text
  }
}

result = if (
  contract.assertDecisionGateTemplateOwnership.apply(artifacts)
) "negative fixture unexpectedly accepted duplicated OpenCode decision-gate ownership"
else throw("decision qualification must be owned by tracked context-sync outputs while sce-decision consumes the gate and adr-template.md owns persisted ADR schema")
