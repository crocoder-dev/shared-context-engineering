import "../generation-contract-check.pkl" as contract

local documents = new Mapping {
  ["config/.opencode/skills/sce-change-to-plan/references/plan-authoring.md"] =
    "## 2.5 Author the acceptance criteria\n\n## 2.6 Author the task stack\n\n## 2.7 Write the plan"
}

result = if (
  contract.assertPlanAuthoringStructuredReferences.apply(documents)
) "negative fixture unexpectedly accepted a plan-authoring phase without the structured authoring order or reference-consistency pass"
else throw("generated plan-authoring.md must author design decisions, acceptance criteria, verification scenarios, and tasks in that order, forbid manufactured decisions and invented test names, add Covers:, and run a reference-consistency pass before writing")
