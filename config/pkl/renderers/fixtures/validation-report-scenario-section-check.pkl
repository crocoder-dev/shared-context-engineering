import "../generation-contract-check.pkl" as contract

local documents = new Mapping {
  ["config/.opencode/skills/sce-validate/references/validation-report.md"] =
    "## Validation Report\n\n### Success-criteria verification\n\n- [x] AC1: {criterion statement} -> {evidence}"
  ["config/.opencode/skills/sce-validate/references/validation.md"] =
    "# Validation report\n\n## Acceptance criteria\n\n- [x] AC1: {criterion statement} — {evidence}"
}

result = if (
  contract.assertValidationReportScenarioSection.apply(documents)
) "negative fixture unexpectedly accepted validation reports without a scenario verification section"
else throw("generated sce-validate validation-report.md and validation.md must carry a scenario verification section mapping each scenario to its acceptance criteria, evidence kind, exact evidence, actual result, and status, cite scenario IDs on acceptance-criterion lines, list unverified scenarios under What failed, and omit the section for legacy plans")
