import "../generation-contract-check.pkl" as contract

local documents = new Mapping {
  ["config/.opencode/skills/sce-validate/references/validation.md"] =
    "## 1.4 Run full validation and acceptance checks\n\nRun the plan's `Full validation` commands."
}

result = if (
  contract.assertValidateScenarioEvidence.apply(documents)
) "negative fixture unexpectedly accepted validation.md without relationship integrity or scenario evidence rules"
else throw("generated sce-validate validation.md must detect structured plans, fail on relationship-integrity defects, run every scenario check itself with exactly one of Verified, Partially verified, or Not verified, check an acceptance criterion only when its Validate: check passes and all its scenarios are Verified, exclude task completion and plan claims as evidence, and keep legacy plans unchanged")
