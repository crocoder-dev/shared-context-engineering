import "../generation-contract-check.pkl" as contract

local documents = new Mapping {
  ["config/.opencode/skills/sce-change-to-plan/references/plan-template.md"] =
    "Context synchronization handoff: {handoff}"
  ["config/.opencode/skills/sce-next-task/references/context-sync.md"] =
    "Validate the handoff."
}

result = if (
  contract.assertHandoffIdentityFields.apply(documents)
) "negative fixture unexpectedly accepted a handoff missing plan path and task identity fields"
else throw("persisted handoff must carry Plan path, Task ID, and Task title, and context-sync validation must require them from the handoff itself")
