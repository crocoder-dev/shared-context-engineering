import "../base/opencode.pkl" as opencode

class RenderedTargetDocument {
  slug: String
  title: String
  frontmatter: String
  body: String
  rendered: String = "\(frontmatter)\n\n\(body)\n"
}

class RenderedTextFile {
  slug: String
  rendered: String
}

sceGeneratedOpenCodePlugins = List(
  opencode.sce_bash_policy_plugin,
  opencode.sce_agent_trace_plugin
)
sceGeneratedOpenCodePluginPathsJson = sceGeneratedOpenCodePlugins
  .map((plugin) -> plugin.path_json)
  .join(", ")
