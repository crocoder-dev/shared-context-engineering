import "../base/decision-skill.pkl" as decision
import "workflow-composite.pkl" as workflowResults

commands {
  for (slug, workflow in workflowResults.workflows) {
    [slug] = workflowResults.renderCommand.apply(workflow, "")
  }
}

skillDocuments {
  for (path, document in workflowResults.skillDocuments.apply("", "$ARGUMENTS", (_) -> "")) {
    [path] = document
  }
  for (path, document in decision.skillDocuments.apply("")) {
    [path] = document
  }
}
