import "../base/workflow-catalog.pkl" as catalog
import "../base/decision-skill.pkl" as decision
import "common.pkl" as common
import "opencode-metadata.pkl" as metadata
import "workflow-composite.pkl" as workflowResults

local generatedOpenCodePluginPathsJson = common.sceGeneratedOpenCodePluginPathsJson

local commandAgentLine = (slug: String) ->
  let (agentSlug = catalog.workflows[slug].openCodeAgentSlug)
    "agent: \"\(metadata.agentDisplayNames[agentSlug])\"\n"

/// One command declares one workflow skill as both its entry skill and its whole
/// skill chain. The skill owns every phase, so there is no sibling package to
/// hand off to.
local commandSkillLines = (slug: String) ->
  let (skillSlug = catalog.workflows[slug].skillSlug)
    "entry-skill: \"\(skillSlug)\"\nskills:\n  - \"\(skillSlug)\"\n"

local agentFrontmatterBySlug = new Mapping {
  for (unitSlug, _ in metadata.agentDisplayNames) {
    [unitSlug] = """
---
name: "\(metadata.agentDisplayNames[unitSlug])"
description: \(metadata.agentDescriptions[unitSlug])
temperature: 0.1
color: "\(metadata.agentColors[unitSlug])"\(metadata.agentBehaviorBlocks[unitSlug])
\(metadata.agentPermissionBlocks[unitSlug])
---
"""
  }
}

local agentBodyBySlug = new Mapping {
  ["shared-context-plan"] = """
Route plan creation and revision through `/change-to-plan`.
"""
  ["shared-context-code"] = """
Route implementation work through `/next-task` and final plan validation through `/validate`.
"""
}

agents {
  for (unitSlug, displayName in metadata.agentDisplayNames) {
    [unitSlug] = new common.RenderedTargetDocument {
      slug = unitSlug
      title = displayName
      frontmatter = agentFrontmatterBySlug[unitSlug]
      body = agentBodyBySlug[unitSlug]
    }
  }
}

/// OpenCode commands are intentionally thin. Each routes to exactly one composite
/// workflow skill, which owns all phases, waits, and final response rendering.
commands {
  for (slug, workflow in workflowResults.workflows) {
    [slug] = workflowResults.renderCommand.apply(
      workflow,
      commandAgentLine.apply(slug) + commandSkillLines.apply(slug)
    )
  }
}

/// OpenCode has six command-routed workflow packages plus the standalone
/// decision-writing package used internally during synchronization. Package-
/// relative paths stay flattened for deterministic generation, and only skill
/// entrypoints carry OpenCode-supported metadata.
skillDocuments {
  for (path, document in workflowResults.skillDocuments.apply("compatibility: \(metadata.skillCompatibility)\n")) {
    [path] = document
  }
  for (path, document in decision.skillDocuments.apply("compatibility: \(metadata.skillCompatibility)\n")) {
    [path] = document
  }
}

opencodeConfig = new common.RenderedTextFile {
  slug = "opencode"
  rendered = """
{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    \(generatedOpenCodePluginPathsJson)
  ]
}
"""
}
