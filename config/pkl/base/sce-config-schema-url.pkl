local semverPattern = #"(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?(\+[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?"#

local function versionParts(version: String): List<String> =
  if (version.matches(Regex(semverPattern))) version.split(".")
  else throw("SCE version '\(version)' is not a semantic version")

function concreteUrl(version: String): String =
  "https://sce.crocoder.dev/v\(version)/config.json"

function series(version: String): String =
  let (parts = versionParts(version)) "\(parts[0]).\(parts[1])"

function seriesPattern(version: String): String =
  let (parts = versionParts(version))
    #"^https://sce\.crocoder\.dev/v"#
      + "\(parts[0])\\.\(parts[1])"
      + #"\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?(\+[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?/config\.json$"#
