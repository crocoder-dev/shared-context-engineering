import "workflow-catalog.pkl" as catalog

class OptionalWorkflowRecord {
  id: String
  title: String
  description: String
  commandSlug: String
  skillSlug: String
}

class OptionalWorkflowManifest {
  schemaVersion: Int
  workflows: Listing<OptionalWorkflowRecord>
}

local manifest: OptionalWorkflowManifest = new {
  schemaVersion = 1
  workflows = new {
    for (slug, workflow in catalog.workflows) {
      when (workflow.optional) {
        new {
          id = slug
          title = workflow.title
          description = workflow.description
          commandSlug = workflow.commandSlug
          skillSlug = workflow.skillSlug
        }
      }
    }
  }
}

local jsonRenderer = new JsonRenderer {
  indent = "  "
}

rendered = jsonRenderer.renderDocument(manifest)
