effectiveWorkflowPolicies: Mapping<String, common.ToolPolicy> = new {
  for (workflowSlug, workflow in workflows) {
    when (executionProfiles.getOrNull(workflow.executionProfile) != null) {
      [workflowSlug] = common.effectiveToolPolicy(
        executionProfiles[workflow.executionProfile].policy.tools,
        workflow.tools
      )
    }
  }
}
