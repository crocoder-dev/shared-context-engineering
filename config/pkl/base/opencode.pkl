class CanonicalOpenCodePluginRegistration {
  id: String
  path: String

  path_json: String = "\"\(path)\""
}

sce_bash_policy_plugin = new CanonicalOpenCodePluginRegistration {
  id = "sce-bash-policy"
  path = "./plugins/sce-bash-policy.ts"
}

sce_agent_trace_plugin = new CanonicalOpenCodePluginRegistration {
  id = "sce-agent-trace"
  path = "./plugins/sce-agent-trace.ts"
}

sce_mutation_scope_plugin = new CanonicalOpenCodePluginRegistration {
  id = "sce-mutation-scope"
  path = "./plugins/sce-mutation-scope.ts"
}
