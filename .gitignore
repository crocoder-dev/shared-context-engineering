# Pkl generator output. Generation is ephemeral (Cargo OUT_DIR); running
# `pkl eval -m .` from the repo root writes these paths, and
# config/pkl/check-generated.sh fails if they are ever committed.
# Deliberately file-scoped: config/schema/agent-trace.schema.json is source.
