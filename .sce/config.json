{
  "$schema": "https://sce.crocoder.dev/config.json",
  "integrations": {
    "target": [
      "claude",
      "opencode",
      "pi"
    ]
  },
  "log_file": "context/tmp/sce.log",
  "log_file_mode": "append",
  "log_level": "error",
  "policies": {
    "attribution_hooks": {
      "enabled": true
    },
    "bash": {
      "custom": [
        {
          "id": "use-nix-flake-check-over-cargo-test",
          "match": {
            "argv_prefix": [
              "cargo",
              "test"
            ]
          },
          "message": "This repository prefers `nix flake check` over direct `cargo test` commands. Run `nix flake check` instead."
        },
        {
          "id": "use-nix-flake-check-over-cargo-fmt-check",
          "match": {
            "argv_prefix": [
              "cargo",
              "fmt",
              "--check"
            ]
          },
          "message": "This repository prefers `nix flake check` over direct `cargo fmt --check`. Run `nix flake check` for verification; keep `cargo fmt` for autofix-only formatting."
        },
        {
          "id": "use-nix-flake-check-over-cargo-check",
          "match": {
            "argv_prefix": [
              "cargo",
              "check"
            ]
          },
          "message": "This repository prefers `nix flake check` over direct `cargo check`. Run `nix flake check` instead."
        },
        {
          "id": "use-nix-for-ripgrep",
          "match": {
            "argv_prefix": [
              "rg"
            ]
          },
          "message": "Run `rg` through nix: `nix run nixpkgs#ripgrep -- <args>`."
        },
        {
          "id": "use-nix-for-jq",
          "match": {
            "argv_prefix": [
              "jq"
            ]
          },
          "message": "Run `jq` through nix: `nix run nixpkgs#jq -- <args>`."
        },
        {
          "id": "use-nix-for-python3",
          "match": {
            "argv_prefix": [
              "python3"
            ]
          },
          "message": "Run `python3` through nix: `nix run nixpkgs#python3 -- <args>`."
        },
        {
          "id": "use-nix-for-node",
          "match": {
            "argv_prefix": [
              "node"
            ]
          },
          "message": "Run `node` through nix: `nix run nixpkgs#nodejs -- <args>`."
        },
        {
          "id": "use-nix-for-bun",
          "match": {
            "argv_prefix": [
              "bun"
            ]
          },
          "message": "Run `bun` through nix: `nix run nixpkgs#bun -- <args>`."
        },
        {
          "id": "use-nix-for-fd",
          "match": {
            "argv_prefix": [
              "fd"
            ]
          },
          "message": "Run `fd` through nix: `nix run nixpkgs#fd -- <args>`."
        },
        {
          "id": "use-nix-for-shellcheck",
          "match": {
            "argv_prefix": [
              "shellcheck"
            ]
          },
          "message": "Run `shellcheck` through nix: `nix run nixpkgs#shellcheck -- <args>`."
        },
        {
          "id": "use-nix-for-actionlint",
          "match": {
            "argv_prefix": [
              "actionlint"
            ]
          },
          "message": "Run `actionlint` through nix: `nix run nixpkgs#actionlint -- <args>`."
        },
        {
          "id": "use-nix-for-yq",
          "match": {
            "argv_prefix": [
              "yq"
            ]
          },
          "message": "Run `yq` through nix: `nix run nixpkgs#yq-go -- <args>`."
        },
        {
          "id": "use-nix-for-hyperfine",
          "match": {
            "argv_prefix": [
              "hyperfine"
            ]
          },
          "message": "Run `hyperfine` through nix: `nix run nixpkgs#hyperfine -- <args>`."
        }
      ],
      "presets": []
    }
  }
}

